---
import type { Project } from '../data/projects';
import { sequences } from '../scripts/dioramas';
import Icon from './Icon.astro';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;
const side = index % 2 === 0 ? 'right' : 'left';
// Only staged dioramas pin the section.
const hold = sequences[project.formation as keyof typeof sequences].stages.length > 1;
// Keep compounds like "Context-Adaptive" on one line.
const title = project.title.replaceAll('-', '‑');
---

<article
  class="scene"
  id={project.slug}
  data-scene
  data-side={side}
  data-field={project.formation}
  data-hold={hold ? '' : undefined}
  data-field-x={side === 'right' ? 0.36 : -0.36}
  data-field-scale="0.9"
  data-accent={project.accent}
  style={`--accent: ${project.accent}`}
  aria-labelledby={`${project.slug}-title`}
>
  <div class="scene-inner">
    <!-- Room for the diorama on narrow screens. -->
    <div class="scene-stage" aria-hidden="true"></div>

    <div class="scene-text" data-reveal-panel>
      <p class="scene-kind" data-reveal><span class="scene-dot" aria-hidden="true"></span>{project.kind}</p>
      <h2 class="scene-title" id={`${project.slug}-title`} data-reveal>{title}</h2>
      <p class="scene-desc" data-reveal>{project.description}</p>

      <ul class="scene-stack" data-reveal aria-label="Stack">
        {project.stack.map((item) => <li>{item}</li>)}
      </ul>

      <div class="scene-links" data-reveal>
        {
          project.links.map((link) => (
            <a class="button" href={link.href} target="_blank" rel="noopener" data-primary={link.kind === 'code' ? '' : undefined}>
              <Icon name={link.kind} />
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</article>

<style>
  .scene {
    position: relative;
    padding: clamp(4rem, 10vw, 6rem) var(--gutter);
  }

  .scene-inner {
    max-width: var(--max);
    margin-inline: auto;
  }

  .scene-stage {
    height: 58svh;
  }

  /* On desktop the panel bleeds past the text column, so the text keeps its width. */
  .scene-text {
    --pad: clamp(1.25rem, 2.2vw, 2rem);
    position: relative;
    display: grid;
    gap: 1.1rem;
    align-content: start;
    max-width: calc(32rem + 2 * var(--pad));
    padding: var(--pad);
    border-radius: 12px;
    border: 1px solid var(--hairline);
    background: var(--paper);
    box-shadow: var(--shadow);
  }

  .scene-title {
    font-size: clamp(1.9rem, 1rem + 2vw, 3.1rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.025em;
    text-wrap: balance;
    margin-bottom: 0.3rem;
  }

  .scene-kind {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .scene-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--accent);
  }

  .scene-desc {
    color: var(--mist);
    font-size: 0.95rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .scene-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--hairline);
    font-size: 0.75rem;
    color: var(--mist);
  }

  .scene-stack li {
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
    background: var(--well);
    line-height: 1.5;
  }

  .scene-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 0.3rem;
  }

  @media (min-width: 64rem) {
    .scene {
      min-height: 100svh;
      padding-block: 0;
    }

    .scene-inner {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 3rem);
      min-height: 100svh;
      align-items: center;
    }

    .scene-stage {
      display: none;
    }

    .scene-text {
      grid-column: 2 / span 4;
      margin-inline: calc(-1 * var(--pad));
    }

    .scene[data-side='left'] .scene-text {
      grid-column: 8 / span 4;
    }

    .scene:not([data-hold]),
    .scene:not([data-hold]) .scene-inner {
      min-height: 125svh;
    }
  }
</style>
