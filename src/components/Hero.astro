---
import { Image } from 'astro:assets';
import portrait from '../../assets/general/me.jpeg';
import { contact } from '../data/projects';
import Icon from './Icon.astro';

const focus = [
  'Applied AI',
  'Machine Learning',
  'Data Science & Analytics',
  'Strategy & Transformation',
  'AI Adoption',
  'Business Strategy',
  'Automation',
  'Generative AI',
  'Agentic Systems',
];
---

<header class="hero" data-hero data-field="name" data-field-text="AI/ML Engineer|& Data Scientist" data-field-x="0" data-field-scale="1" data-field-opacity="1.4" data-accent="#1a2530">
  <div class="hero-center">
    <!-- Drawn by the particle field; shown as text without WebGL. -->
    <h1 class="hero-name">AI/ML Engineer &amp; Data Scientist</h1>
    <ul class="hero-focus" data-hero-fade aria-label="Focus areas">
      {focus.map((item) => <li>{item}</li>)}
    </ul>
  </div>

  <div class="hero-foot" data-hero-fade>
    <div class="hero-id">
      <Image class="hero-avatar" src={portrait} alt="Portrait of Roger Vergés" widths={[96, 192]} sizes="3rem" loading="eager" />
      <div>
        <p class="hero-role">Roger Vergés</p>
        <p class="hero-place">Based in Helsinki, Finland</p>
      </div>
    </div>

    <p class="hero-label">Portfolio</p>

    <nav class="hero-contact" aria-label="Contact">
      <a class="button" href={`mailto:${contact.email}`}><Icon name="mail" />Email</a>
      <a class="button" href={contact.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" />LinkedIn</a>
      <a class="button" href={contact.github} target="_blank" rel="noopener"><Icon name="code" />GitHub</a>
    </nav>
  </div>
</header>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    padding: var(--gutter);
    max-width: var(--max);
    margin-inline: auto;
  }

  .hero-center {
    align-self: center;
    display: grid;
    justify-items: center;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin-top: -6vh;
  }

  .hero-focus {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    max-width: 52rem;
    gap: 0.5rem;
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--text);
    text-align: center;
  }

  .hero-focus li {
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--hairline);
    box-shadow: 0 1px 2px rgba(26, 37, 48, 0.06);
  }

  /* Centred without transforms: the load animation owns this element's transform. */
  :global(.has-field) .hero-focus {
    position: absolute;
    top: 67%;
    left: var(--gutter);
    right: var(--gutter);
    margin-inline: auto;
  }

  @media (max-width: 40rem) {
    .hero-focus {
      gap: 0.35rem;
      font-size: 0.8rem;
    }

    :global(.has-field) .hero-focus {
      top: 60%;
    }
  }

  .hero-name {
    font-size: clamp(3.2rem, 1rem + 9vw, 10rem);
    font-weight: 750;
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-align: center;
    text-wrap: balance;
  }

  /* Screen-reader only once the field draws it. */
  :global(.has-field) .hero-name {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .hero-foot {
    grid-row: 2;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: end;
    gap: 1.5rem clamp(1.5rem, 3vw, 3rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--hairline);
  }

  .hero-id {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .hero-id :global(.hero-avatar) {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: 52% 38%;
    flex: none;
    filter: saturate(0.9);
  }

  .hero-role {
    font-weight: 560;
    line-height: 1.3;
  }

  .hero-place,
  .hero-label {
    color: var(--ash);
    font-size: var(--step--1);
  }

  .hero-label {
    justify-self: center;
  }

  .hero-contact {
    display: grid;
    grid-template-columns: repeat(3, 7.5rem);
    gap: 0.5rem;
  }

  .hero-contact .button {
    justify-content: center;
  }

  @media (max-width: 40rem) {
    .hero-foot {
      grid-template-columns: 1fr;
    }

    .hero-contact {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .hero-label {
      display: none;
    }
  }

  :global(.motion) [data-hero-fade],
  :global(.field-pending) .hero-name {
    opacity: 0;
  }
</style>
