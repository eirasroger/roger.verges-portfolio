---
import { Image } from 'astro:assets';
import portrait from '../../assets/general/me.jpeg';
import { contact } from '../data/projects';
import Icon from './Icon.astro';
---

<!-- The particles fade out here. -->
<footer class="contact" aria-labelledby="contact-title" data-field="scatter" data-field-x="0" data-field-scale="1" data-field-opacity="0" data-accent="#7c8794">
  <div class="contact-inner">
    <h2 class="visually-hidden" id="contact-title">Contact</h2>
    <div class="contact-row">
      <div class="contact-id">
        <Image class="contact-avatar" src={portrait} alt="Portrait of Roger Vergés" widths={[112, 224]} sizes="3.5rem" />
        <div>
          <p class="contact-name">Roger Vergés</p>
          <p class="contact-place">Based in Helsinki, Finland</p>
        </div>
      </div>
      <nav class="contact-links" aria-label="Contact">
        <a class="button" href={`mailto:${contact.email}`}><Icon name="mail" />Email</a>
        <a class="button" href={contact.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" />LinkedIn</a>
        <a class="button" href={contact.github} target="_blank" rel="noopener"><Icon name="code" />GitHub</a>
      </nav>
    </div>
    <div class="contact-base">
      <a class="link contact-email" href={`mailto:${contact.email}`}>{contact.email}</a>
      <p>© {new Date().getFullYear()} Roger Vergés</p>
    </div>
  </div>
</footer>

<style>
  .contact {
    padding: clamp(3rem, 8vw, 6rem) var(--gutter) var(--gutter);
  }

  .contact-inner {
    max-width: var(--max);
    margin-inline: auto;
    display: grid;
    gap: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--hairline);
  }

  .contact-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .contact-id {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .contact-id :global(.contact-avatar) {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: 52% 38%;
    flex: none;
  }

  .contact-name {
    font-size: var(--step-1);
    font-weight: 650;
    letter-spacing: -0.01em;
    line-height: 1.25;
  }

  .contact-place,
  .contact-base {
    color: var(--ash);
    font-size: var(--step--1);
  }

  .contact-links {
    display: grid;
    grid-template-columns: repeat(3, 7.5rem);
    gap: 0.5rem;
  }

  .contact-links .button {
    justify-content: center;
  }

  .contact-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }

  .contact-email {
    color: var(--mist);
  }

  @media (max-width: 40rem) {
    .contact-links {
      width: 100%;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
